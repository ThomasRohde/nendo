<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- ADR-0036. The browser host: the Engine and Nendo.Session on WebAssembly, answering the
       Workbench's bridge from inside the page. Needs the wasm-tools workload, which links
       SQLite's emscripten build into the runtime. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmBuildNative>true</WasmBuildNative>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The Engine and the bridge serialize JSON by reflection, as Desktop does. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Trim the framework only: Nendo's own types keep the metadata that reflection reads. -->
    <TrimMode>partial</TrimMode>
    <!-- Partial trimming keeps those assemblies whole, so the analysis's warnings about reflection
         describe code that is not removed. Desktop is not trimmed at all, for the same reason. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nendo.Engine\Nendo.Engine.csproj" />
    <ProjectReference Include="..\Nendo.Session\Nendo.Session.csproj" />
  </ItemGroup>

  <!-- The page carries the runtime and these packages, so it carries their licences too
       (ADR-0035): the publish leaves the runtime pack's notices and the restore's package list in
       notices/, and the Workbench's scripts/pack-browser-host.mjs writes them into the page. -->
  <Target Name="PublishLicenceNotices" AfterTargets="Publish">
    <ItemGroup>
      <_NendoRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <_NendoRuntimeNotices Include="@(_NendoRuntimePack->'%(PackageDirectory)\LICENSE.TXT');@(_NendoRuntimePack->'%(PackageDirectory)\THIRD-PARTY-NOTICES.TXT')" />
    </ItemGroup>
    <Error Condition="'@(_NendoRuntimeNotices)' == '' or !Exists('%(_NendoRuntimeNotices.FullPath)')" Text="The .NET runtime pack's notices were not found: @(_NendoRuntimeNotices)." />
    <Copy SourceFiles="@(_NendoRuntimeNotices)" DestinationFiles="@(_NendoRuntimeNotices->'$(PublishDir)notices\dotnet-%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(ProjectAssetsFile)" DestinationFolder="$(PublishDir)notices" />
  </Target>

</Project>
