<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Nendo.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Nendo.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Nendo"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        The page fills the window from its top edge. Nendo's top bar is the window's title
        bar (W-093), and Windows draws its own buttons over the bar's right end: see
        MainWindow.TitleBar.cs. MainPage holds the Workbench and the recovery panel.
    -->
    <Frame x:Name="RootFrame" />
</Window>
