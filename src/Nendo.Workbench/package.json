{
  "name": "nendo-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.api.config.ts",
    "check": "tsc --noEmit",
    "test": "node --test \"scripts/*.test.mjs\"",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "verify:dependencies": "node scripts/verify-dependencies.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "ag-grid-community": "36.1.0",
    "marked": "17.0.6"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
