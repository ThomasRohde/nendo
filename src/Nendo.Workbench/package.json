{
  "name": "nendo-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.api.config.ts",
    "check": "tsc --noEmit",
    "test": "node --test \"scripts/*.test.mjs\"",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "verify:dependencies": "node scripts/verify-dependencies.mjs"
  },
  "dependencies": {
    "ag-grid-community": "36.1.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
