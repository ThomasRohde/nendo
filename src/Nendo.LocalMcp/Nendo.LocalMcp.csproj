<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- The Tasks extension (SEP-2663) is experimental in SDK 2.2.0: MCPEXP001 is the specification feature, MCPEXP002 the extensibility seam it uses (W-152). -->
    <NoWarn>$(NoWarn);MCPEXP001;MCPEXP002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nendo.Engine\Nendo.Engine.csproj" />
  </ItemGroup>

  <!--
    The view API reference (W-094): the Workbench's api build writes it beside api.js, from the
    tables api.js is built from, and this assembly carries it as built for
    nendo://application/view-api.
  -->
  <PropertyGroup>
    <ViewApiReference>..\Nendo.Workbench\dist\_nendo\view-api.json</ViewApiReference>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(ViewApiReference)" LogicalName="Nendo.LocalMcp.view-api.json" Visible="false" />
  </ItemGroup>

  <Target Name="RequireViewApiReference" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ViewApiReference)')"
           Text="src/Nendo.Workbench/dist/_nendo/view-api.json is missing, and the local MCP serves it as nendo://application/view-api. Build the Workbench first: npm run build in src/Nendo.Workbench." />
  </Target>

</Project>
