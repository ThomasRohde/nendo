---
// Pagefind indexes dist/ after the build and is loaded only when somebody types, so
// a reader who never searches downloads none of it.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="docs-search">
  <label class="visually-hidden" for="docs-search-input">Search the documentation</label>
  <input
    id="docs-search-input"
    type="search"
    placeholder="Search the documentation"
    autocomplete="off"
    role="combobox"
    aria-expanded="false"
    aria-controls="docs-search-results"
    aria-autocomplete="list"
    data-pagefind-base={`${base}/pagefind/pagefind.js`}
    data-dev={import.meta.env.DEV ? 'true' : undefined}
  />
  <!-- tabindex -1: a scrolling box is otherwise a Tab stop of its own, and Tab should
       leave the combobox; the arrow keys move through the results. -->
  <div id="docs-search-results" class="docs-search-results" role="listbox" aria-label="Search results" tabindex="-1" hidden></div>
  <p class="docs-search-status visually-hidden" role="status" aria-live="polite"></p>
</div>

<style>
  .docs-search { position: relative; margin-bottom: 22px; }

  .docs-search input {
    width: 100%;
    padding: 9px 13px;
    border: 1px solid var(--control-line);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
  }

  .docs-search input::placeholder { color: var(--muted); }

  .docs-search-results {
    position: absolute;
    z-index: 20;
    left: 0;
    /* The documentation rail scrolls, so a wider child is clipped at its edge. */
    width: min(430px, 100%);
    margin-top: 6px;
    max-height: 58vh;
    overflow-y: auto;
    padding: 6px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface-raised);
    box-shadow: var(--shadow);
  }

  .docs-search-results :global(a) {
    display: block;
    padding: 9px 11px;
    border-radius: var(--radius-sm);
    color: var(--ink);
    text-decoration: none;
  }

  .docs-search-results :global(a:hover),
  .docs-search-results :global(a:focus-visible) { background: var(--surface-soft); }
  .docs-search-results :global(strong) { display: block; font-size: 0.9rem; margin-bottom: 2px; }
  .docs-search-results :global(span) { color: var(--muted); font-size: 0.8rem; line-height: 1.45; }
  .docs-search-results :global(mark) { background: var(--cobalt-soft); color: inherit; }
  .docs-search-results :global(p.empty) { margin: 0; padding: 9px 11px; color: var(--muted); font-size: 0.85rem; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  type SubResult = { title?: string; url: string; excerpt?: string; locations?: number[]; weighted_locations?: { balanced_score?: number }[] };
  type ResultData = { url: string; meta: { title?: string }; excerpt: string; sub_results?: SubResult[] };

  const input = document.querySelector<HTMLInputElement>('#docs-search-input');
  const results = document.querySelector<HTMLElement>('.docs-search-results');
  const status = document.querySelector<HTMLElement>('.docs-search-status');
  if (input && results && status) {
    let pagefind: { debouncedSearch: (term: string, options?: unknown, delay?: number) => Promise<{ results: { data: () => Promise<ResultData> }[] } | null> } | null = null;
    let loading: Promise<void> | null = null;

    // The combobox's popup state is announced from aria-expanded, and what the search
    // found from the live status line, which stays outside the hidden panel.
    const setOpen = (open: boolean) => {
      results.hidden = !open;
      input.setAttribute('aria-expanded', String(open));
    };
    const announce = (text: string) => { status.textContent = text; };

    const load = () => {
      loading ??= (async () => {
        const source = input.dataset.pagefindBase;
        if (!source) return;
        try {
          // Vite wraps a dynamic import in its preload helper even behind
          // @vite-ignore, and the helper fails on a module it has no manifest
          // entry for. This import is opaque to the bundler, so it is left alone.
          const importModule = new Function('url', 'return import(url)') as (url: string) => Promise<typeof pagefind>;
          pagefind = await importModule(source);
        } catch {
          // Forget the failed attempt, so the next keystroke tries again: on the live
          // site a dropped connection is the likely cause. The index only exists after
          // a production build, which is what the dev server says instead.
          loading = null;
          const message = input.dataset.dev === 'true' ? 'Search is available on the built site.' : 'Search could not load. Try again.';
          results.innerHTML = `<p class="empty">${message}</p>`;
          setOpen(true);
          announce(message);
        }
      })();
      return loading;
    };

    // A search is answered over several awaits, and the reader keeps typing, clears the
    // field or dismisses the panel meanwhile. Every one of those moves the generation on,
    // and an answer is shown only if its own generation is still the current one: an
    // older, slower search must not reopen a dismissed panel or replace a newer answer.
    let generation = 0;
    const dismiss = () => { generation += 1; setOpen(false); };

    const escapeText = (text: string) => text.replace(/[&<>"]/g, character => `&#${character.charCodeAt(0)};`);
    // Pagefind splits a page into sections at its headings. The section with the most
    // weight is where the match is, so the result opens there rather than at the top
    // of a long guide.
    const weight = (section: SubResult) => section.weighted_locations
      ? section.weighted_locations.reduce((sum, location) => sum + (location.balanced_score ?? 0), 0)
      : section.locations?.length ?? 0;
    const bestSection = (item: ResultData) => {
      let best: SubResult | null = null;
      for (const section of item.sub_results ?? []) {
        if (best === null || weight(section) > weight(best)) best = section;
      }
      return best !== null && best.url.includes('#') ? best : null;
    };

    input.addEventListener('focus', () => void load());

    input.addEventListener('input', async () => {
      const request = ++generation;
      const term = input.value.trim();
      if (term.length < 2) { setOpen(false); results.innerHTML = ''; announce(''); return; }
      await load();
      if (request !== generation || !pagefind) return;
      const search = await pagefind.debouncedSearch(term, undefined, 200);
      if (request !== generation || search === null) return;
      const top = await Promise.all(search.results.slice(0, 8).map(result => result.data()));
      if (request !== generation) return;
      results.innerHTML = top.length === 0
        ? '<p class="empty">Nothing matched.</p>'
        : top.map((item, index) => {
          const section = bestSection(item);
          const page = item.meta.title ?? item.url;
          const title = section?.title && section.title !== page ? `${page} › ${section.title}` : page;
          // Pagefind returns the excerpt with the source page's own markup in it, so a
          // result could carry a link inside a link. Keep the match highlight, drop the rest.
          const excerpt = (section?.excerpt ?? item.excerpt).replace(/<(?!\/?mark\b)[^>]*>/g, '');
          return `<a href="${section?.url ?? item.url}" role="option" id="docs-search-option-${index}" tabindex="-1" aria-selected="false"><strong>${escapeText(title)}</strong><span>${excerpt}</span></a>`;
        }).join('');
      setOpen(true);
      announce(top.length === 0 ? 'Nothing matched.' : `${top.length} ${top.length === 1 ? 'result' : 'results'}. Press the down arrow to reach them.`);
    });

    document.addEventListener('click', event => {
      if (!(event.target instanceof Node)) return;
      if (!results.contains(event.target) && event.target !== input) dismiss();
    });

    const options = () => [...results.querySelectorAll<HTMLAnchorElement>('[role="option"]')];
    const focusOption = (index: number) => {
      const list = options();
      if (list.length === 0) return;
      const target = (index + list.length) % list.length;
      list.forEach((option, at) => option.setAttribute('aria-selected', String(at === target)));
      list[target].focus();
    };

    // Escape closes the panel and leaves the query and the focus where they were. The
    // browser's own Escape on a search field would also wipe the query.
    input.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        event.preventDefault();
        dismiss();
      } else if (event.key === 'ArrowDown' && !results.hidden && options().length > 0) {
        event.preventDefault();
        focusOption(0);
      }
    });

    // Tabbing out of the field or a result leaves nothing behind that says it is open.
    const leave = (event: FocusEvent) => {
      const next = event.relatedTarget;
      if (next !== input && !(next instanceof Node && results.contains(next))) dismiss();
    };
    input.addEventListener('focusout', leave);
    results.addEventListener('focusout', leave);

    results.addEventListener('keydown', event => {
      const at = options().indexOf(document.activeElement as HTMLAnchorElement);
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        focusOption(at + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (at <= 0) input.focus();
        else focusOption(at - 1);
      } else if (event.key === 'Escape') {
        event.preventDefault();
        dismiss();
        input.focus();
      }
    });
  }
</script>
