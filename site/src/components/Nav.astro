---
import { Image } from 'astro:assets';
import mark from '../assets/brand/nendo-mark.png';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(/\/$/, '') || base;

// `rest` is the part of a label a phone drops, so all five fit on one row at 375px.
const links = [
  { href: `${base}/concept/`, label: 'Concept' },
  { href: `${base}/how-it-works/`, label: 'How it works' },
  { href: `${base}/use/`, label: 'Using', rest: ' Nendo' },
  { href: `${base}/status/`, label: 'Status' },
  { href: `${base}/docs/`, label: 'Docs' },
];
const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, '');
  return here === target || here.startsWith(`${target}/`);
};
---

<header class="site-nav">
  <div class="page nav-inner">
    <a class="brand" href={`${base}/`}>
      <Image src={mark} alt="" width={38} densities={[1, 2]} />
      <span>nendo</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {links.map(link => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}{link.rest && <span class="label-rest">{link.rest}</span>}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="nav-end">
      <ThemeToggle />
      <a class="repo-link" href="https://github.com/ThomasRohde/nendo" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path></svg>
        <span class="repo-label">GitHub</span>
      </a>
    </div>
  </div>
</header>
<script is:inline>
  // Inline and synchronous, so the measured height is in place before the browser
  // scrolls to a #fragment: scroll-padding-top and the docs rail's sticky top read it.
  (() => {
    const header = document.querySelector('.site-nav');
    if (!header) return;
    const root = document.documentElement;
    const write = () => root.style.setProperty('--header-height', `${Math.ceil(header.getBoundingClientRect().height)}px`);
    write();
    if ('ResizeObserver' in window) new ResizeObserver(write).observe(header);

    // On a phone the links are one scrolling row. Bring the current page's link into
    // view, and fade the edge that has more links behind it.
    const nav = header.querySelector('nav');
    if (!nav) return;
    const current = nav.querySelector('[aria-current="page"]');
    const reveal = () => {
      if (!current) return;
      const overshoot = current.getBoundingClientRect().right - nav.getBoundingClientRect().right;
      if (overshoot > 0) nav.scrollLeft += overshoot + 16;
    };
    reveal();
    // The web font is wider than the fallback the row was first laid out in.
    document.fonts?.ready.then(reveal);
    const cue = () => {
      const end = nav.scrollWidth - nav.clientWidth;
      nav.classList.toggle('fade-start', nav.scrollLeft > 1);
      nav.classList.toggle('fade-end', end > 1 && nav.scrollLeft < end - 1);
    };
    nav.addEventListener('scroll', cue, { passive: true });
    if ('ResizeObserver' in window) new ResizeObserver(cue).observe(nav);
    cue();
  })();
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--canvas) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 62px;
    padding-block: 8px;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--ink);
    text-decoration: none;
  }

  nav { margin-inline-end: auto; }

  nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
  }

  nav a {
    display: inline-block;
    padding: 7px 12px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.93rem;
    font-weight: 620;
    text-decoration: none;
  }

  nav a:hover { color: var(--ink); background: var(--surface-soft); }

  nav a[aria-current='page'] {
    color: var(--cobalt);
    background: var(--cobalt-soft);
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-raised);
    box-shadow: inset 0 -3px 0 var(--edge);
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 620;
    text-decoration: none;
  }

  .repo-link svg { width: 16px; height: 16px; fill: currentColor; }

  /* Up to 860px the header has two rows: the brand and the controls, then the links
     as one scrolling row. Between 721 and 860 it used to wrap the controls onto a
     second, left-aligned row of a third height instead. */
  @media (max-width: 860px) {
    .nav-inner { min-height: 0; gap: 10px; padding-block: 6px; }
    /* One scrolling row rather than two wrapped ones: a sticky header that takes a
       fifth of a phone screen is a header nobody wants. */
    nav {
      order: 3;
      width: 100%;
      margin-inline-end: 0;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    nav::-webkit-scrollbar { display: none; }
    nav.fade-end { mask-image: linear-gradient(to right, #000 calc(100% - 36px), transparent); }
    nav.fade-start { mask-image: linear-gradient(to left, #000 calc(100% - 36px), transparent); }
    nav.fade-start.fade-end { mask-image: linear-gradient(to right, transparent, #000 36px, #000 calc(100% - 36px), transparent); }
    nav ul { flex-wrap: nowrap; justify-content: flex-start; }
    nav a { padding: 5px 10px; font-size: 0.87rem; white-space: nowrap; }
    .nav-end { margin-inline-start: auto; }
  }

  @media (max-width: 720px) {
    /* Hidden from sight only: display: none would also take the link's only text out
       of its accessible name. */
    .repo-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .repo-link { padding: 7px 10px; }
  }

  @media (max-width: 480px) {
    nav ul { gap: 2px; }
    nav a { position: relative; padding: 5px 8px; }
    /* Out of sight, but still part of the link's name: "Using Nendo". */
    .label-rest {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
