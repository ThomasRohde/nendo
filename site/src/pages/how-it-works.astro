---
import Page from '../layouts/Page.astro';
import Prose from '../components/Prose.astro';
import Shot from '../components/Shot.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const lanes = [
  {
    name: 'The data lane',
    what: 'Record create, update and delete; CSV import.',
    how: 'Written straight to the file in a validated transaction, with per-record version checks and idempotency keys. Everyday data entry never waits for a copy and a preview.',
  },
  {
    name: 'The application lane',
    what: 'Schema, screens, constraints and commands.',
    how: 'Changes are made on a copy of the file. Nendo validates them and shows a diff first, and accepting them is a separate step that happens in the Nendo app itself.',
  },
];

const operations = [
  ['schema.createEntity', 'data.createRecord', 'ui.addNode', 'extension.setPackage'],
  ['schema.addField', 'data.setField', 'ui.setProperty', 'extension.putFile'],
  ['schema.renameEntity', 'data.deleteRecord', 'ui.moveNode', 'extension.removeFile'],
  ['schema.renameField', 'data.restoreDeletedRecord *', 'ui.removeNode', 'extension.removePackage'],
  ['schema.setFieldRequired', 'data.backfillRetiredField', '', ''],
  ['schema.setRetired', 'data.convertLegacyReference', 'behaviour.setDefinition', ''],
  ['schema.setChoiceMetadata', 'identity.transition *', 'behaviour.removeDefinition', ''],
  ['schema.configureReference', '', 'application.setPurpose', ''],
];

const reversibility = [
  { name: 'reversible', body: 'It has a proven inverse, and applying it lost nothing.' },
  { name: 'reversibleWithRetainedState', body: 'Undoing it needs data the file kept on purpose, and the file records that it did.' },
  { name: 'irreversibleDeclared', body: 'Something cannot be recovered, and you are told before you accept.' },
];

const accessLevels = [
  { name: 'Off', body: 'Nothing can connect. This is the default, and the right setting whenever no agent is working.' },
  { name: 'Inspect', body: 'An agent can read the schema, the screens and the records, and change nothing.' },
  { name: 'Edit data', body: 'An agent can create, change and delete records, but not the schema or the screens.' },
  { name: 'Shape app', body: 'An agent can propose changes to the application. A person accepts each one.' },
  { name: 'Unattended', body: 'The agent accepts its own proposals, and nobody reviews them first. It is off by default, must be confirmed before it takes effect, is never saved, and ends when the file closes.' },
];

const screens = [
  'recordList', 'boardSurface', 'gallerySurface', 'calendarSurface', 'timelineSurface',
  'matrixSurface', 'rankedList', 'detailSurface', 'overviewSurface', 'recordForm',
  'recordCommand', 'relatedList', 'summaryTile', 'breakdownChart', 'trendChart',
  'progressTile', 'rangeTile', 'activityGrid', 'recentList', 'filterClause',
  'section', 'tabGroup', 'fieldBinding', 'commandStep', 'extensionGraphSurface',
  'extensionRecordsSurface', 'extensionRecordPanel',
];
---

<Page
  title="How Nendo works — Nendo"
  description="The file format, the two ways a file changes, the complete list of operations, how changes are reviewed and applied, how screens are built, and how agents connect."
  eyebrow="How it works"
  heading="One file, two lanes, a fixed set of operations."
  lede="A Nendo application is data in a SQLite file. The installed app builds the screens from that data, and every change is one of a small number of named operations."
>
  <section class="page section">
    <Prose>
      <h2>The file</h2>
      <p>
        An application is a single SQLite file with the extension <code>.nendo</code> and
        application id <code>0x4E454E44</code>. It uses a rollback (DELETE) journal,
        <code>synchronous=FULL</code> and a two-second busy timeout. Write-ahead logging
        was measured and rejected.
      </p>
      <p>
        Each file records a <code>minimumHostVersion</code>. An older version of Nendo
        refuses to open a newer file instead of opening part of it, and opening an older
        file never upgrades or rewrites it. A file can grow to 256&nbsp;MiB, roughly 75,500
        text-heavy records; a cold open at that size took about 6.6 seconds.
      </p>
      <p>
        Each record type is an ordinary relational table. Stable IDs map record types and
        fields to their physical names, so renaming something doesn't break the screens
        that use it. Numbers are exact by contract: <code>decimal</code> values use the
        .NET decimal range, are stored as exact text, and never pass through a JavaScript
        number anywhere in the product.
      </p>
    </Prose>
  </section>

  <section class="page section">
    <p class="eyebrow">Two lanes</p>
    <h2>Entering data and changing the application are handled differently.</h2>
    <div class="grid grid-2 lanes">
      {lanes.map(lane => (
        <article class="panel">
          <h3>{lane.name}</h3>
          <p class="lane-what">{lane.what}</p>
          <p>{lane.how}</p>
        </article>
      ))}
    </div>
    <p class="aside">
      Separate revision histories for definitions and for data, one overall change
      sequence, and a version number on every record keep the two apart. Editing a
      record doesn't invalidate a pending proposal that only touches screens.
    </p>
  </section>

  <section class="page section">
    <p class="eyebrow">The vocabulary</p>
    <h2>Twenty-six operations, twenty-four of them open to agents.</h2>
    <p class="lede">
      These are the only ways the file can change. There is no raw SQL and no
      general-purpose escape hatch. The two marked <code>*</code> are available only in
      the Nendo app itself.
    </p>
    <div class="table-scroll operations">
      <table>
        <thead>
          <tr><th>Schema</th><th>Data</th><th>Screens, behaviour and purpose</th><th>Custom-view code</th></tr>
        </thead>
        <tbody>
          {operations.map(row => (
            <tr>{row.map(cell => <td>{cell ? <code>{cell}</code> : ''}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3 class="sub">Every operation says whether it can be undone</h3>
    <div class="grid reversibility">
      {reversibility.map(item => (
        <article>
          <code>{item.name}</code>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
    <div class="note">
      <p>
        A change that loses data is never called reversible just because a backup
        exists. There is <strong>no universal undo</strong>. Reversing a change applies its
        inverse as a <em>new</em> revision; history is never rewound.
      </p>
    </div>
  </section>

  <section class="page section">
    <p class="eyebrow">Review and acceptance</p>
    <h2>Your file is never swapped for the copy.</h2>
    <ol class="lifecycle">
      <li><strong>Draft</strong><span>An agent puts together a change set: an ordered list of operations with one purpose.</span></li>
      <li><strong>Validating</strong><span>Nendo makes a physical copy of the file and applies the changes there. The copy cannot affect your file.</span></li>
      <li><strong>Previewable</strong><span>The changes applied cleanly to the copy. You read a diff that describes them in plain terms.</span></li>
      <li><strong>Applying</strong><span>You accept. Nendo rechecks every precondition, then applies exactly the operations it validated to your file.</span></li>
      <li><strong>Active</strong><span>The change is now a revision in your file's history, labelled with whether it can be undone.</span></li>
    </ol>
    <div class="note">
      <p>
        Below Unattended, agents have <strong>no MCP tool for accepting changes</strong>.
        A person accepts them in the Nendo app. At Unattended, the tool
        <code>nendo.change_set.accept</code> lets an agent accept its own validated changes.
      </p>
    </div>
  </section>

  <section class="page section">
    <p class="eyebrow">Screens</p>
    <h2>Screens are built from a fixed set of parts.</h2>
    <p class="lede">
      A screen is an ordered tree of nodes, each one of the kinds below. Agents read that
      list from the same table Nendo validates against, so they are never offered a kind
      that will then be refused. The format is contract version 3, the only one this
      version of Nendo accepts.
    </p>
    <ul class="kinds">{screens.map(kind => <li><code>{kind}</code></li>)}</ul>
    <div class="kind-notes">
      <p>
        A summary tile computes an exact <code>count</code>, <code>sum</code>,
        <code>min</code> or <code>max</code>. <strong>It refuses <code>avg</code></strong>
        and says why: the average of exact decimals is usually not an exact decimal.
      </p>
      <p>
        A chart shows exact totals over a fixed set of groups, such as a choice field's
        options, a yes/no field or the months of a Date field, drawn to scale with the
        numbers beside them. A dashboard is a page of these tiles and charts. Neither
        stores a layout, a formula or sampled data.
      </p>
      <p>
        If any screen fails to compile, Nendo shows none of the custom screens rather than
        half an application. Studio is there either way.
      </p>
    </div>
  </section>

  <section class="page section">
    <p class="eyebrow">Studio</p>
    <h2>Studio is always there.</h2>
    <p class="lede">
      Every valid file opens with Nendo Studio and its five areas: Data, Structure,
      Surfaces, History and Health. It works with no record types, no agent, no custom
      screens, a broken definition, or a file opened in safe mode.
    </p>
    <div class="studio-shots">
      <Shot name="studio-structure" alt="The Studio Structure area showing record types, their fields and relationships" caption="Structure: record types, fields and relationships." />
      <Shot name="studio-history" alt="The Studio History area listing revisions in order with what each one changed" caption="History: every revision in order, and what it changed." />
    </div>
  </section>

  <section class="page section">
    <p class="eyebrow">Agents</p>
    <h2>Five access levels, one lease, no password.</h2>
    <p class="lede">
      Agents talk to a stateless MCP server that listens only on this computer, at
      <code>http://127.0.0.1:41763/mcp</code>. Fourteen resources are read-only and need
      no lease. There are nineteen tools, and the ones that write need the lease. The test
      suite checks both lists by name.
    </p>
    <ol class="levels">
      {accessLevels.map((level, index) => (
        <li>
          <span class="level-index">{index}</span>
          <div>
            <h3>{level.name}</h3>
            <p>{level.body}</p>
          </div>
        </li>
      ))}
    </ol>
    <Prose class="agent-prose">
      <p>
        The edit lease is an opaque <code>applicationHandle</code> and a
        <code>leaseId</code>, and every write needs both. Whoever holds the handle holds
        the lease, whatever name the client gives and whichever HTTP connection it uses.
        By default the lease never expires: the client releases it, and the person can
        revoke it at any time. The person can turn on a lease expiry under Agent →
        Connection.
      </p>
      <p>
        You can see an agent working from any screen. The status indicator names the
        client and what it is doing, as in <em>Claude Code is writing to this file…</em>,
        instead of a bare <em>Still working…</em>
      </p>
      <p>
        <a href={`${base}/docs/agents`}>Working with agents</a>
        lists every resource and tool, and what each refusal means.
      </p>
    </Prose>
  </section>

  <section class="page section">
    <p class="eyebrow">Behaviour</p>
    <h2>Calculations and automatic actions.</h2>
    <Prose>
      <p>
        A calculated field is stored as a definition, not as a column you can edit. It
        shows a value, <em>Not set</em>, <em>Calculating…</em>, or <em>Cannot
        calculate</em> with the reason. Screens can't sort, filter, group or total by a
        calculated field; they refuse and explain why, rather than quietly sorting only the
        rows already loaded.
      </p>
      <p>
        Formulas run in a restricted evaluator with a fixed set of functions and hard
        limits. A file with no calculations never loads the evaluator. An edit and every
        automatic action it triggers are saved together or not at all.
      </p>
      <p>
        A file with a trigger can't be edited until you approve that exact behaviour on
        this computer. Approvals are stored in your user profile, never in the
        <code>.nendo</code> file, so a file can't grant itself permission and a copy asks
        again.
      </p>
      <p>
        Custom views are the one place a file carries code. A view's HTML and JavaScript
        arrive in the file as a package, reviewed line by line in a proposal, and run when
        the view is shown, in a frame of Nendo's own window. Each package gets a web
        address and a browser process of its own, apart from Nendo's own page. A view
        reads the file only through a closed set of typed calls, the same reads Nendo's own
        screens make, and cannot reach Nendo's page, SQL or a file path. It can reach the
        network and the clipboard. There is no install step and no permission dialog:
        switches on this computer turn views off, for every file or for one. In this
        version a view reads and does not write.
      </p>
    </Prose>
  </section>
</Page>

<style>
  .lanes { margin-top: 24px; }
  .lanes h3 { margin-bottom: 8px; }
  .lane-what { font-weight: 620; }
  .lanes p:last-child { color: var(--muted); font-size: 0.94rem; margin: 0; }

  .aside {
    margin-top: 20px;
    max-width: 64ch;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .operations { margin-top: 24px; }
  .operations code { background: none; border: 0; padding: 0; font-size: 0.85rem; }

  .sub { margin-top: 44px; }

  .reversibility { margin-top: 16px; }
  .reversibility article {
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--violet);
    border-radius: var(--radius);
    background: var(--surface-raised);
  }
  .reversibility code { font-size: 0.82rem; }
  .reversibility p { margin: 8px 0 0; color: var(--muted); font-size: 0.9rem; }

  .note { margin-top: 24px; max-width: 70ch; }

  .lifecycle {
    list-style: none;
    counter-reset: step;
    margin: 26px 0 0;
    padding: 0;
    border-left: 2px solid var(--line);
  }

  .lifecycle li {
    position: relative;
    padding: 0 0 22px 26px;
  }

  .lifecycle li::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 8px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--cobalt);
  }

  .lifecycle strong { display: block; font-family: var(--font-display); font-size: 1.02rem; }
  .lifecycle span { display: block; color: var(--muted); font-size: 0.93rem; max-width: 62ch; }

  .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .kinds code {
    font-size: 0.82rem;
    background: var(--surface-raised);
  }

  .kind-notes {
    margin-top: 26px;
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  }

  .kind-notes p { margin: 0; color: var(--muted); font-size: 0.94rem; }
  .kind-notes strong { color: var(--ink); }

  .studio-shots {
    display: grid;
    gap: 26px;
    margin-top: 26px;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
  }

  .levels {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .levels li {
    display: flex;
    gap: 16px;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-raised);
  }

  .levels li:last-child { border-color: color-mix(in srgb, var(--warning) 45%, var(--line)); }

  .level-index {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--surface-soft);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .levels h3 { font-size: 0.98rem; margin-bottom: 4px; }
  .levels p { margin: 0; color: var(--muted); font-size: 0.93rem; }

  .agent-prose { margin-top: 26px; }

  @media (max-width: 640px) {
    .studio-shots { grid-template-columns: 1fr; }
  }
</style>
