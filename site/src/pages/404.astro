---
import Base from '../layouts/Base.astro';
import BrandMark from '../components/BrandMark.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Not found — Nendo" description="That page does not exist on this site.">
  <section class="page missing">
    <BrandMark width={88} />
    <p class="eyebrow">404</p>
    <h1>That page does not exist.</h1>
    <p class="lede">
      The documentation here is rendered from the repository, so a link written against
      a file path may not have a page. Try the index, or read it on GitHub.
    </p>
    <div class="actions">
      <a class="button button-primary" href={`${base}/`}>Home</a>
      <a class="button button-quiet" href={`${base}/docs`}>All documents</a>
      <a class="button button-quiet" href="https://github.com/ThomasRohde/nendo" rel="noopener">Repository</a>
    </div>
  </section>
</Base>

<style>
  .missing {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(60px, 12vw, 130px);
  }

  .missing .eyebrow { margin-top: 24px; }
  .missing h1 { max-width: 18ch; }
  .missing .lede { max-width: 52ch; margin-bottom: 28px; }

  .actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
</style>
