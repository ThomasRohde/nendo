---
import Base from '../layouts/Base.astro';
import BrandMark from '../components/BrandMark.astro';
import Shot from '../components/Shot.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repository = 'https://github.com/ThomasRohde/nendo';

const loop = [
  'Create an empty file',
  'Add or import schema and data',
  'Work in the default Studio table',
  'Ask an agent for a form, board or record page',
  'Read the semantic diff',
  'Accept, observe, compensate',
];

// The shape of a real proposal, in plain words. The lines are illustrative; a real
// one lists the typed operations the agent sent.
const proposal = [
  ['Add board', 'Crew by role'],
  ['Columns', 'Crew › Role'],
  ['Card title', 'Crew › Name'],
  ['Card field', 'Crew › Callsign'],
];

const showcase = [
  { name: 'board', label: 'A board', alt: 'A board surface grouping crew records into columns by role, with per-column counts', blurb: 'Columns come from a choice field or a reference, each with a count. Drag a card to another column and the record changes with it.' },
  { name: 'record-page', label: 'A record page', alt: 'A component record page with a toned header, two commands and a form', blurb: 'A coloured header, related lists, collapsible sections, and commands such as Take offline and Return to service.' },
  { name: 'calendar', label: 'A calendar', alt: 'A calendar surface placing maintenance records on a month', blurb: 'Records placed on a month by a Date field. Times of day and recurring events are not supported.' },
  { name: 'timeline', label: 'A timeline', alt: 'A timeline surface laying incidents along one civil year', blurb: 'Records laid out by start date, one calendar year at a time.' },
  { name: 'gallery', label: 'A gallery', alt: 'A gallery surface: experiment records as cards with a rating drawn on a closed scale', blurb: 'Records as cards, with a rating shown as dots on a fixed scale.' },
  { name: 'matrix', label: 'A matrix', alt: 'A matrix surface: two crossed choice fields answered by one grouped read', blurb: 'Two choice fields crossed into a grid, with an exact count in every cell, including the empty ones.' },
  { name: 'overview', label: 'A front page', alt: 'The Nendo Station front page, with count tiles, a progress ring and a breakdown chart', blurb: 'A page for the whole file rather than one record type: counts, a progress ring and a breakdown chart.' },
  { name: 'studio-data', label: 'Studio, always', alt: 'The Studio Data area showing the Components table with sort and filter controls', blurb: 'Every valid file opens here, and nothing an application or an agent adds can remove it.' },
];
---

<Base
  title="Nendo — malleable software in a single file"
  description="Nendo turns a single SQLite file into a working application that people and coding agents shape together: schema, data, screens and history, with no generated code and no build step."
>
  <section class="page hero">
    <div class="hero-text">
      <p class="tag"><span class="dot"></span>Experimental research prototype, v0.12.0 for Windows x64</p>
      <h1>Malleable software in a single file.</h1>
      <p class="hero-lede">
        A Nendo application is one SQLite file. It starts empty, and you and your coding
        agents shape it into a working application with its own schema, data, forms,
        boards, record pages and history. Nothing is generated or built, and changing it
        never means starting over.
      </p>
      <p class="clay"><em>Nendo</em> (粘土) is Japanese for clay.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={`${base}/concept`}>Why this exists</a>
        <a class="button button-quiet" href={`${base}/use`}>Using Nendo</a>
        <a class="button button-quiet" href={repository} rel="noopener">Source on GitHub</a>
      </div>
    </div>
    <div class="hero-mark">
      <BrandMark width={440} />
    </div>
  </section>

  <section class="page">
    <Shot
      name="overview"
      priority
      alt="Nendo showing the Station status front page: count tiles, a progress ring and a breakdown chart, with the Studio rail beside it"
      caption="Nendo Station, the fourth reference application. Captured from a running host on 2026-09-22 by tools/Capture-SiteScreenshots.ps1."
    />
  </section>

  <section class="page section">
    <div class="split">
      <div class="panel">
        <p class="eyebrow">The problem</p>
        <h2>Generated apps are easy to make and hard to keep.</h2>
        <p>
          An AI can write a small application in minutes, but the result is another silo.
          The data is tied to code nobody intends to maintain, every change means
          generating it again, and there is no visible history or way back. When the code
          breaks, the data is stuck inside it.
        </p>
        <p>
          Low-code tools fix some of this, but your application then lives on someone
          else's platform, in their format. You can't keep it as a file to copy, inspect
          and open offline ten years from now.
        </p>
      </div>
      <div class="panel panel-violet">
        <p class="eyebrow">The idea</p>
        <h2>Software you reshape instead of regenerate.</h2>
        <p>
          A <code>.nendo</code> file holds the schema, the data, the screens and the
          history. People and agents change it in place with a small set of typed
          operations. The desktop app, the web Workbench and an agent connected over MCP
          all use the same operations and the same validation.
        </p>
        <p><a href={`${base}/how-it-works`}>How it works</a></p>
      </div>
    </div>
  </section>

  <section class="page section">
    <h2>Shape it, review it, accept it.</h2>
    <ol class="loop">
      {loop.map((step, index) => (
        <li>
          <span class="loop-index">{index + 1}</span>
          <span>{step}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="page section">
    <div class="panel agents">
      <div class="agents-text">
        <p class="eyebrow">Agents</p>
        <h2>An agent's changes wait for you to accept them.</h2>
        <p>
          Agents connect over MCP, and only from this computer. They get no SQL, no
          database path and no file access, just a fixed set of typed operations. Nendo
          tries each change on a separate copy of your file and shows you the result as a
          readable diff. When you accept, it applies the same operations to your file. The
          copy is never swapped in.
        </p>
        <pre><code>claude mcp add --transport http nendo http://127.0.0.1:41763/mcp
codex mcp add nendo --url http://127.0.0.1:41763/mcp</code></pre>
        <p class="quiet">
          That address is all the configuration a client needs; there is no key or
          password. The flip side is that any program on this computer can connect at the
          access level you have set, so turn agent access <strong>Off</strong> when no agent
          is working.
        </p>
      </div>

      <div class="proposal" data-proposal>
        <div class="proposal-head">
          <p class="proposal-who">Claude Code proposes</p>
          <h3>A board of crew, grouped by role</h3>
          <p>4 operations, validated on a clone of Nendo Station.nendo</p>
        </div>
        <div class="proposal-diff" role="list" aria-label="Proposed operations">
          {proposal.map(([what, target]) => (
            <div class="op" role="listitem"><span class="op-sign" aria-hidden="true">+</span><span class="op-what">{what}</span><span>{target}</span></div>
          ))}
          <div class="op op-context" role="listitem"><span class="op-sign" aria-hidden="true"></span><span class="op-what">Records</span><span>12 unchanged</span></div>
        </div>
        <p class="proposal-rev">Reversibility: <strong>reversible</strong>. Removing the board removes only the board.</p>
        <div class="proposal-actions" data-proposal-actions>
          <button type="button" class="button button-quiet" data-proposal-reject>Reject</button>
          <button type="button" class="button button-primary" data-proposal-accept>Accept</button>
        </div>
        <div class="proposal-result" data-proposal-result aria-live="polite">
          <div data-proposal-accepted hidden>
            <p>Accepted. The same 4 operations were applied to Nendo Station.nendo.</p>
            <Shot name="board" alt="The new board: crew records in columns by role, with a count on each column" />
          </div>
          <p data-proposal-rejected hidden>Rejected. Your file did not change.</p>
          <button type="button" class="again" data-proposal-reset hidden>Show the proposal again</button>
        </div>
        <p class="proposal-note">An illustration. A real proposal lists the exact operations the agent sent.</p>
      </div>
    </div>
  </section>

  <section class="page section">
    <h2>Screens are data in the file.</h2>
    <p class="lede">
      Each screen below is stored in the file as a tree of typed parts, and Nendo builds
      the screen from it when the file opens. Nothing is generated, so there is no code
      to lose or review.
    </p>
    <div class="showcase">
      {showcase.map(item => (
        <article>
          <Shot name={item.name} alt={item.alt} />
          <h3>{item.label}</h3>
          <p>{item.blurb}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page section">
    <div class="split brand-split">
      <div>
        <p class="eyebrow">The name</p>
        <h2>Why clay</h2>
        <p>
          Clay holds its shape, and you can reshape it without starting over. That is the
          idea: the file you start with is the file you keep, however many changes you or
          an agent make to it.
        </p>
        <p>
          A few fixed rules protect that. An empty file is valid. Studio, the built-in
          table view, can't be removed. Changes are previewed on a copy, never on your
          data. Every operation states whether it can be undone.
        </p>
        <p><a href={`${base}/concept`}>Read all eight axioms</a></p>
      </div>
      <div class="brand-video">
        <video
          src={`${base}/brand/nendo.mp4`}
          muted
          loop
          playsinline
          autoplay
          preload="metadata"
          aria-label="The Nendo mark, animated"
        ></video>
      </div>
    </div>
    <script is:inline>
      // autoplay is an attribute, so it cannot be withheld per reader. Stop it for
      // anyone who asked for less motion, and leave the first frame on the card.
      (() => {
        const video = document.querySelector('.brand-video video');
        if (!video) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          video.removeAttribute('autoplay');
          video.removeAttribute('loop');
          video.controls = true;
          video.pause();
        }
      })();
    </script>
  </section>

  <section class="page section">
    <div class="panel status-band">
      <p class="eyebrow">Status</p>
      <h2>Where it stands</h2>
      <p>
        The core loop works end to end. Four reference applications, each shaped
        differently, put the idea to the test, and two of them were built from an empty
        file by an agent working only through MCP.
      </p>
      <p>
        Public releases, code signing, ARM64, cloud sync and other platforms are
        <strong>not</strong> supported. Every usability, scaling and accessibility result
        so far comes from the author's own testing; nobody else has evaluated it yet.
      </p>
      <p><a href={`${base}/status`}>Full status, including what hasn't been tested</a></p>
    </div>
  </section>
</Base>

<script>
  // The proposal demo. Nothing leaves the page: Accept and Reject only swap which
  // outcome is shown, so a reader can see both ends of the review.
  for (const root of document.querySelectorAll<HTMLElement>('[data-proposal]')) {
    const actions = root.querySelector<HTMLElement>('[data-proposal-actions]')!;
    const accepted = root.querySelector<HTMLElement>('[data-proposal-accepted]')!;
    const rejected = root.querySelector<HTMLElement>('[data-proposal-rejected]')!;
    const reset = root.querySelector<HTMLButtonElement>('[data-proposal-reset]')!;

    const show = (outcome: 'accepted' | 'rejected' | null) => {
      actions.hidden = outcome !== null;
      accepted.hidden = outcome !== 'accepted';
      rejected.hidden = outcome !== 'rejected';
      reset.hidden = outcome === null;
      root.dataset.outcome = outcome ?? '';
    };

    root.querySelector('[data-proposal-accept]')!.addEventListener('click', () => { show('accepted'); reset.focus(); });
    root.querySelector('[data-proposal-reject]')!.addEventListener('click', () => { show('rejected'); reset.focus(); });
    reset.addEventListener('click', () => {
      show(null);
      root.querySelector<HTMLButtonElement>('[data-proposal-accept]')!.focus();
    });
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 24px;
    align-items: center;
    padding-block: clamp(32px, 6vw, 72px) clamp(36px, 5vw, 60px);
  }

  .hero h1 {
    font-size: clamp(3rem, 8vw, 6.4rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    margin: 20px 0 26px;
  }

  .hero-lede {
    max-width: 50ch;
    font-size: clamp(1.08rem, 1.8vw, 1.22rem);
    color: var(--muted);
  }

  .clay {
    color: var(--violet);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .hero-mark {
    position: relative;
    justify-self: center;
    width: min(440px, 100%);
  }

  /* The shadow the clay casts on the ground it stands on. */
  .hero-mark::after {
    content: "";
    position: absolute;
    inset: auto 14% -4% 14%;
    height: 10%;
    border-radius: 50%;
    background: var(--glow);
    filter: blur(18px);
    z-index: -1;
  }

  .hero-mark :global(.brand-mark) { width: 100%; filter: none; }

  .split {
    display: grid;
    gap: 22px;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }

  .split h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .split p { max-width: 54ch; }

  .panel-violet {
    background: var(--violet-slab);
    color: var(--on-violet);
  }

  .panel-violet .eyebrow,
  .panel-violet a { color: var(--on-violet); }

  .panel-violet code {
    background: rgba(255, 255, 255, 0.16);
    border-color: transparent;
    color: var(--on-violet);
  }

  .loop {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 26px 0 0;
    padding: 0;
  }

  .loop li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 22px 11px 11px;
    border-radius: 999px;
    background: var(--surface-raised);
    box-shadow: var(--shadow-soft);
    font-weight: 600;
  }

  .loop-index {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--press);
    color: var(--cobalt);
    font-family: var(--font-display);
    font-weight: 800;
  }

  .agents {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }

  /* Grid items default to min-width: auto, so the long MCP command would widen the
     column past a phone screen instead of scrolling inside its own block. */
  .agents > * { min-width: 0; }
  .agents h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); }
  .agents p { max-width: 58ch; }
  .agents pre { margin: 22px 0; }
  .quiet { color: var(--muted); font-size: 0.93rem; }

  /* The proposal is a pressed-in tray on the slab: it is the thing waiting for you. */
  .proposal {
    background: var(--canvas);
    border-radius: var(--radius);
    box-shadow: inset 0 4px 12px var(--edge);
    padding: 22px;
  }

  .proposal-head h3 { margin: 2px 0 4px; }
  .proposal-head p { margin: 0; font-size: 0.9rem; color: var(--muted); }
  .proposal-head .proposal-who { color: var(--violet); font-weight: 650; }

  .proposal-diff {
    margin: 16px 0 0;
    padding: 8px 0;
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.9;
    overflow-x: auto;
  }

  .op {
    display: grid;
    grid-template-columns: 1.4em 7.5em 1fr;
    padding: 0 14px;
    white-space: nowrap;
  }

  .op:not(.op-context) { background: var(--healthy-soft); }
  .op-sign { color: var(--healthy); font-weight: 700; }
  .op-what { color: var(--muted); }
  .op-context { color: var(--muted); }

  .proposal-rev {
    margin: 14px 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .proposal-rev strong { color: var(--healthy); font-weight: 650; }

  .proposal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 18px;
  }

  .proposal-actions .button { padding: 11px 22px; }

  .proposal-result > :not([hidden]) { margin-top: 18px; }
  .proposal-result p { font-weight: 650; }

  [data-outcome] .proposal-result > div:not([hidden]),
  [data-outcome] .proposal-result > p:not([hidden]) {
    animation: settle 420ms cubic-bezier(0.22, 1.35, 0.36, 1) both;
  }

  @keyframes settle {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
  }

  .again {
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--cobalt);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .proposal-note {
    margin: 16px 0 0;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .showcase {
    display: grid;
    gap: 40px 28px;
    margin-top: 32px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .showcase h3 { margin: 20px 0 4px; font-size: 1.45rem; }

  .showcase article > p {
    color: var(--muted);
    max-width: 48ch;
    margin: 0;
  }

  .brand-split { align-items: center; }

  .brand-video {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    /* The sting was authored on an opaque near-white backdrop, so it sits on a card
       that matches it rather than bleeding into a dark page. */
    background: #f6f6f4;
    line-height: 0;
  }

  .brand-video video { display: block; width: 100%; height: auto; }

  .status-band h2 { max-width: 20ch; }
  .status-band p { max-width: 62ch; }

  @media (max-width: 860px) {
    .hero, .agents { grid-template-columns: 1fr; }
    .hero-mark { order: -1; width: min(240px, 60%); justify-self: start; }
    .showcase { grid-template-columns: 1fr; }
  }
</style>
