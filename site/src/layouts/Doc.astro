---
import Base from './Base.astro';
import Prose from '../components/Prose.astro';
import DocsSearch from '../components/DocsSearch.astro';
import { docGroups, type DocLink } from '../docs-nav';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  current: string;
  headings: MarkdownHeading[];
}
const { title, description, current, headings } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = await docGroups();
const onPage = headings.filter(heading => heading.depth === 2 || heading.depth === 3);

const flat: DocLink[] = groups.flatMap(group => group.items);
const index = flat.findIndex(item => item.id === current);
const previous = index > 0 ? flat[index - 1] : null;
const next = index !== -1 && index < flat.length - 1 ? flat[index + 1] : null;
---

<Base title={`${title} — Nendo documentation`} description={description}>
  <div class="page docs-shell">
    <div class="docs-rail">
      <DocsSearch />
      <!-- Open in the markup, so a page that runs no script still lists the guides. On
           a phone the inline script right after it closes it, so the guide comes before
           its index. -->
      <details class="docs-guides" open>
        <summary>Guides<span class="docs-guides-current">{flat[index]?.title}</span></summary>
        <nav aria-label="Guides">
          {groups.map(group => (
            <div class="docs-group">
              <p class="docs-group-label">{group.title}</p>
              <ul>
                {group.items.map(item => (
                  <li>
                    <a href={item.href} aria-current={item.id === current ? 'page' : undefined}>{item.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </details>
      <script is:inline>
        // Inline and synchronous, so the list is already closed when the browser scrolls
        // to a #fragment: closed later, it shrinks by about 350px under the reader and
        // carries the target heading up past the header. It also never flashes open.
        (() => {
          const details = document.currentScript?.previousElementSibling;
          if (!(details instanceof HTMLDetailsElement)) return;
          const narrow = window.matchMedia('(max-width: 820px)');
          const apply = () => { details.open = !narrow.matches; };
          apply();
          narrow.addEventListener('change', apply);
        })();
      </script>
    </div>

    <article class="docs-body" data-pagefind-body>
      <h1 class="docs-title">{title}</h1>
      <p class="docs-lede">{description}</p>
      {onPage.length > 0 && (
        <details class="docs-toc-compact" data-pagefind-ignore>
          <summary>On this page</summary>
          <nav aria-label="On this page">
            <ul>
              {onPage.map(heading => (
                <li class:list={[heading.depth === 3 && 'is-nested']}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      )}
      <Prose>
        <slot />
      </Prose>
      <nav class="docs-pager" aria-label="Documents">
        {previous ? <a class="pager-previous" href={previous.href}><span>Previous</span><strong>{previous.title}</strong></a> : <span></span>}
        {next ? <a class="pager-next" href={next.href}><span>Next</span><strong>{next.title}</strong></a> : <span></span>}
      </nav>
    </article>

    <nav class="docs-toc" aria-label="On this page">
      {onPage.length > 0 && (
        <>
          <p class="docs-group-label">On this page</p>
          <ul>
            {onPage.map(heading => (
              <li class:list={[heading.depth === 3 && 'is-nested']}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </>
      )}
      <a class="toc-top" href={`${base}/docs/`}>All guides</a>
    </nav>
  </div>
</Base>

<style>
  .docs-shell {
    display: grid;
    gap: 34px;
    grid-template-columns: 246px minmax(0, 1fr) 208px;
    align-items: start;
    padding-block: 34px;
  }

  /* Both columns stick below the header, whatever height it has at this width. */
  .docs-rail,
  .docs-toc {
    position: sticky;
    top: calc(var(--header-height) + 16px);
    max-height: calc(100vh - var(--header-height) - 38px);
    overflow-y: auto;
    font-size: 0.9rem;
  }

  .docs-guides > summary { display: none; }
  .docs-group + .docs-group { margin-top: 22px; }

  .docs-group-label {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 720;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 8px;
  }

  .docs-rail ul,
  .docs-toc ul,
  .docs-toc-compact ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-rail a,
  .docs-toc a,
  .docs-toc-compact a {
    display: block;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    color: var(--muted);
    text-decoration: none;
    line-height: 1.35;
  }

  .docs-rail a:hover,
  .docs-toc a:hover,
  .docs-toc-compact a:hover { color: var(--ink); background: var(--surface-soft); }

  .docs-rail a[aria-current='page'] {
    color: var(--cobalt);
    background: var(--cobalt-soft);
    font-weight: 640;
  }

  .docs-toc .is-nested a,
  .docs-toc-compact .is-nested a { padding-left: 22px; font-size: 0.85rem; }

  .toc-top {
    margin-top: 14px;
    display: inline-block;
    color: var(--cobalt) !important;
  }

  .docs-body { min-width: 0; }

  .docs-title {
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    margin: 0 0 10px;
  }

  .docs-lede {
    margin: 0 0 26px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 1.08rem;
    max-width: 62ch;
  }

  /* The On-this-page list for a window too narrow for its own column. */
  .docs-toc-compact { display: none; }

  .docs-toc-compact,
  .docs-guides {
    font-size: 0.92rem;
  }

  .docs-toc-compact > summary,
  .docs-guides > summary {
    cursor: pointer;
    padding: 9px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    color: var(--ink);
    font-weight: 650;
  }

  .docs-toc-compact[open] > summary,
  .docs-guides[open] > summary { margin-bottom: 8px; }

  .docs-guides-current {
    margin-left: 8px;
    color: var(--muted);
    font-weight: 500;
  }

  .docs-guides-current::before { content: '· '; }

  .docs-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .docs-pager a {
    display: block;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-raised);
    text-decoration: none;
  }

  .docs-pager span {
    display: block;
    color: var(--muted);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .docs-pager strong { color: var(--ink); font-size: 0.95rem; }
  .pager-next { text-align: right; }

  @media (max-width: 1100px) {
    .docs-shell { grid-template-columns: 224px minmax(0, 1fr); }
    .docs-toc { display: none; }
    .docs-toc-compact { display: block; margin: 0 0 26px; }
  }

  @media (max-width: 820px) {
    .docs-shell { grid-template-columns: 1fr; gap: 22px; }
    .docs-rail {
      position: static;
      max-height: none;
    }
    .docs-guides > summary { display: list-item; }
    .docs-pager { grid-template-columns: 1fr; }
    .pager-next { text-align: left; }
  }
</style>
