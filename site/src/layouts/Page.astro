---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lede: string;
}
const { title, description, eyebrow, heading, lede } = Astro.props;
---

<Base title={title} description={description}>
  <header class="page-head">
    <div class="page">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="lede">{lede}</p>
    </div>
  </header>
  <slot />
</Base>

<style>
  .page-head {
    padding-block: clamp(40px, 6vw, 72px) clamp(24px, 4vw, 40px);
    border-bottom: 1px solid var(--line);
    background: linear-gradient(to bottom, var(--surface), var(--canvas));
  }

  .page-head h1 { max-width: 20ch; }
  .page-head .lede { margin-top: 14px; }
</style>
