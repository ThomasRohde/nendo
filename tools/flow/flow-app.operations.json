           "resultType": "Text",
           "nullable": false
          },
          {
           "bindingId": "edgeTo",
           "kind": "ReferenceTraversal",
           "entityId": "fl.run",
           "referenceFieldId": "fl.run.choice",
           "relatedEntityId": "fl.edge",
           "fieldId": "fl.edge.toKey",
           "resultType": "Text",
           "nullable": true
          }
         ],
         "callAliases": []
        },
        {
         "fieldId": "fl.run.path",
         "expression": "Concat(path, ' › ', current)",
         "bindings": [
          {
           "bindingId": "path",
           "kind": "SameRecordField",
           "entityId": "fl.run",
           "fieldId": "fl.run.path",
           "resultType": "Text",
           "nullable": true
          },
          {
           "bindingId": "current",
           "kind": "SameRecordField",
           "entityId": "fl.run",
           "fieldId": "fl.run.currentKey",
           "resultType": "Text",
