  {
   "operationType": "behaviour.setDefinition",
   "payload": {
    "definitionId": "fl.run.advance",
    "definitionKind": "Action",
    "body": {
     "displayName": "Move a run along the chosen edge",
     "steps": [
      {
       "stepId": "10-advance",
       "kind": "SetField",
       "target": {
        "kind": "EventRecord"
       },
       "assignments": [
        {
         "fieldId": "fl.run.currentKey",
