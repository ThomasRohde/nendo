  {
   "operationType": "behaviour.setDefinition",
   "payload": {
    "definitionId": "fl.run.begin",
    "definitionKind": "Action",
    "body": {
     "displayName": "Begin a run on the edge leaving the Start",
     "steps": [
      {
       "stepId": "10-begin",
       "kind": "SetField",
       "target": {
        "kind": "EventRecord"
       },
       "assignments": [
        {
         "fieldId": "fl.run.currentKey",
         "expression": "(fromKind == 'Start' and edgeFlow == runFlow) ? edgeTo : Refuse('A run begins on the edge that leaves the Start of its own flow.')",
         "bindings": [
          {
           "bindingId": "fromKind",
           "kind": "ReferenceTraversal",
           "entityId": "fl.run",
           "referenceFieldId": "fl.run.choice",
           "relatedEntityId": "fl.edge",
           "fieldId": "fl.edge.fromKind",
           "resultType": "Text",
           "nullable": true
          },
          {
           "bindingId": "edgeFlow",
           "kind": "ReferenceTraversal",
           "entityId": "fl.run",
           "referenceFieldId": "fl.run.choice",
           "relatedEntityId": "fl.edge",
           "fieldId": "fl.edge.flowKey",
           "resultType": "Text",
           "nullable": true
          },
          {
           "bindingId": "runFlow",
           "kind": "ReferenceTraversal",
           "entityId": "fl.run",
           "referenceFieldId": "fl.run.flow",
           "relatedEntityId": "fl.flow",
           "fieldId": "fl.flow.key",
           "resultType": "Text",
           "nullable": false
          },
          {
           "bindingId": "edgeTo",
           "kind": "ReferenceTraversal",
           "entityId": "fl.run",
           "referenceFieldId": "fl.run.choice",
           "relatedEntityId": "fl.edge",
           "fieldId": "fl.edge.toKey",
           "resultType": "Text",
           "nullable": true
          }
         ],
         "callAliases": []
        },
        {
         "fieldId": "fl.run.path",
         "expression": "current",
         "bindings": [
          {
           "bindingId": "current",
           "kind": "SameRecordField",
           "entityId": "fl.run",
           "fieldId": "fl.run.currentKey",
           "resultType": "Text",
           "nullable": true
          }
         ],
         "callAliases": []
        },
        {
         "fieldId": "fl.run.status",
         "expression": "toKind == 'End' ? 'Finished' : 'Running'",
         "bindings": [
          {
           "bindingId": "toKind",
           "kind": "ReferenceTraversal",
           "entityId": "fl.run",
           "referenceFieldId": "fl.run.choice",
           "relatedEntityId": "fl.edge",
           "fieldId": "fl.edge.toKind",
           "resultType": "Text",
           "nullable": true
          }
         ],
         "callAliases": []
        }
