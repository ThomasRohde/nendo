           "resultType": "Text",
           "nullable": true
          },
          {
           "bindingId": "edgeFlow",
           "kind": "ReferenceTraversal",
           "entityId": "fl.run",
           "referenceFieldId": "fl.run.choice",
           "relatedEntityId": "fl.edge",
           "fieldId": "fl.edge.flowKey",
           "resultType": "Text",
           "nullable": true
          },
          {
           "bindingId": "runFlow",
           "kind": "ReferenceTraversal",
           "entityId": "fl.run",
           "referenceFieldId": "fl.run.flow",
           "relatedEntityId": "fl.flow",
