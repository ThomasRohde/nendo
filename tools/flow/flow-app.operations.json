           "resultType": "Text",
           "nullable": true
          }
         ],
         "callAliases": []
        }
       ]
      }
     ]
    }
   }
  },
  {
   "operationType": "behaviour.setDefinition",
   "payload": {
    "definitionId": "fl.run.hold",
    "definitionKind": "Action",
    "body": {
