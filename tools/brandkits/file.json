 "example": {
  "kit": [
   {
    "recordId": "k-example-roaster",
    "values": {
     "kitName": "Example: Ember & Oak",
     "kitBrief": "An example kit that shows how Brandkits works: a small coffee roaster in Aarhus that sells beans online and from one café. Its Accent fails contrast on the cream background, and one Ask waits with three warmer accents to choose from. Safe to delete.",
     "kitTagline": "Roasted slow. Poured warm.",
     "kitPersonality": "Warm, Crafted, Plain-spoken, Unhurried",
     "kitVoice": "Warm, not sugary.\nCrafted, not precious.\nPlain-spoken, not blunt.\nUnhurried, not slow to answer.\nDo: name the farm, the roast date and the taste.\nDo: write like the person behind the counter.\nDon't: artisanal, curated, elevate.\nDon't: exclamation marks in headlines.",
     "kitImagery": "Daylight photography in the roastery and the café: hands, sacks, steam, wood. Warm and slightly underexposed, never staged on white.\nIllustration is limited to the bean mark and simple line drawings of origins.",
     "kitStatus": "Draft"
    }
   }
  ],
