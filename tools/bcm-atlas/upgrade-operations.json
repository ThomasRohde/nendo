[
  {
    "description": "Define Assessment",
    "operations": [
      {
        "operationType": "schema.createEntity",
        "payload": {
          "entityId": "bcm.assessment",
          "displayName": "Assessment"
        }
      },
      {
        "operationType": "schema.addField",
        "payload": {
          "entityId": "bcm.assessment",
          "fieldId": "assess.name",
          "displayName": "Assessment",
          "storageKind": "text",
          "required": true
        }
      },
      {
        "operationType": "schema.addField",
        "payload": {
          "entityId": "bcm.assessment",
          "fieldId": "assess.capability",
          "displayName": "Capability",
          "storageKind": "reference",
          "required": true
        }
      },
      {
        "operationType": "schema.addField",
        "payload": {
          "entityId": "bcm.assessment",
          "fieldId": "assess.dimension",
          "displayName": "Dimension",
          "storageKind": "text",
          "required": true,
          "presentation": "singleChoice",
          "options": [
            "Maturity",
            "Business value",
            "IT health"
          ]
        }
      },
      {
        "operationType": "schema.addField",
        "payload": {
          "entityId": "bcm.assessment",
          "fieldId": "assess.score",
          "displayName": "Score",
          "storageKind": "integer",
          "required": true,
          "presentation": "rating",
          "min": 1,
          "max": 5
        }
      },
      {
        "operationType": "schema.addField",
        "payload": {
          "entityId": "bcm.assessment",
          "fieldId": "assess.date",
          "displayName": "Assessed on",
          "storageKind": "date",
          "required": true,
          "presentation": "date"
        }
      },
      {
        "operationType": "schema.addField",
        "payload": {
          "entityId": "bcm.assessment",
          "fieldId": "assess.assessor",
          "displayName": "Assessor",
          "storageKind": "text",
          "required": false
        }
      },
      {
        "operationType": "schema.addField",
        "payload": {
          "entityId": "bcm.assessment",
          "fieldId": "assess.evidence",
          "displayName": "Evidence",
          "storageKind": "text",
          "required": false,
          "presentation": "longText"
        }
      }
    ]
  },
  {
    "description": "Connect assessments to capabilities, keep capability codes unique and require both ends of a support link",
    "operations": [
      {
        "operationType": "schema.configureReference",
        "payload": {
          "entityId": "bcm.assessment",
          "fieldId": "assess.capability",
          "targetEntityId": "bcm.capability",
          "labelFieldId": "cap.name"
        }
      },
      {
        "operationType": "schema.setChoiceMetadata",
        "payload": {
          "entityId": "bcm.assessment",
          "fieldId": "assess.dimension",
          "choiceId": "Maturity",
          "displayName": "Maturity",
          "retired": false,
          "tone": "blue"
        }
      },
      {
        "operationType": "schema.setChoiceMetadata",
        "payload": {
          "entityId": "bcm.assessment",
          "fieldId": "assess.dimension",
          "choiceId": "Business value",
          "displayName": "Business value",
          "retired": false,
          "tone": "violet"
        }
      },
      {
        "operationType": "schema.setChoiceMetadata",
        "payload": {
          "entityId": "bcm.assessment",
          "fieldId": "assess.dimension",
          "choiceId": "IT health",
          "displayName": "IT health",
          "retired": false,
          "tone": "teal"
        }
      },
      {
        "operationType": "schema.setFieldUnique",
        "payload": {
          "entityId": "bcm.capability",
          "fieldId": "cap.code",
          "unique": true
        }
      },
      {
        "operationType": "schema.setFieldRequired",
        "payload": {
          "entityId": "bcm.support",
          "fieldId": "support.capability",
          "required": true
        }
      },
      {
        "operationType": "schema.setFieldRequired",
        "payload": {
          "entityId": "bcm.support",
          "fieldId": "support.application",
          "required": true
        }
      }
    ]
  },
