<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkCompatibilityInitialize>false</WindowsAppSdkCompatibilityInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="Nendo.Engine.Tests" />
  </ItemGroup>

  <!-- Shared with the Engine tests rather than copied: one file, linked. -->
  <ItemGroup>
    <Compile Include="..\Nendo.Engine.Tests\CompiledPlanTestExtensions.cs" Link="CompiledPlanTestExtensions.cs" />
    <Compile Include="..\Nendo.Engine.Tests\TestRepository.cs" Link="TestRepository.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nendo.Desktop\Nendo.Desktop.csproj" />
  </ItemGroup>

</Project>
