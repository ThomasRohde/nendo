<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- One product version for the whole tree. Every assembly carries it, and
         NendoProduct reads it back at runtime so the status bar, the MCP server
         handshake and the installer registration cannot drift from each other. -->
    <Version>0.15.0</Version>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>
</Project>
